{
  "name": "fylune",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first document workspace for Markdown, MDX, JSON, and office files",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @fylune/backend --filter @fylune/desktop dev",
    "dev:desktop": "pnpm --filter @fylune/desktop dev",
    "dev:backend": "pnpm --filter @fylune/backend dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test:unit",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @fylune/backend prisma:generate",
    "db:migrate": "pnpm --filter @fylune/backend prisma:migrate"
  }
}
