{
  "name": "@fylune/desktop",
  "version": "0.1.6",
  "private": true,
  "description": "Open-source local-first document workspace for macOS and Windows",
  "author": "StarSeek Lab",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "electron/bootstrap.cjs",
  "files": [
    "build",
    "dist/client",
    "electron",
    "scripts/release-after-pack.mjs"
  ],
  "scripts": {
    "dev": "concurrently -k -n renderer,electron -c blue,green \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http-get://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:renderer": "vite",
    "agent:rpc": "node scripts/fylune-agent-rpc.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "pack": "pnpm build && electron-builder --dir",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src electron tests --max-warnings=0",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --config vitest.config.mjs && vitest run --config vitest.main.config.mjs",
    "cli:link": "node scripts/link-cli.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fylune/document-collaboration": "workspace:*",
    "@parcel/watcher": "2.6.0",
    "docx-preview": "^0.4.0",
    "electron-updater": "6.8.9",
    "exceljs": "^4.4.0",
    "fast-glob": "3.3.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "numfmt": "^3.2.6",
    "pdfjs-dist": "6.2.108",
    "pptxtojson": "^2.1.0",
    "typebox": "^1.3.8",
    "write-file-atomic": "7.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@eslint/js": "9.39.2",
    "@fylune/components": "workspace:*",
    "@lexical/react": "0.48.0",
    "@lezer/highlight": "1.2.3",
    "@mdxeditor/editor": "4.1.0",
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/coverage-v8": "4.0.17",
    "codemirror": "6.0.2",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.8.1",
    "eslint": "9.39.2",
    "globals": "17.3.0",
    "i18next": "^25.10.10",
    "jsdom": "28.1.0",
    "katex": "0.18.1",
    "lexical": "0.48.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.16.1",
    "micromark-extension-math": "3.1.0",
    "nanoid": "5.1.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^16.6.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.4.2",
    "vitest": "4.0.17",
    "wait-on": "9.0.3",
    "yaml": "2.9.0",
    "zustand": "5.0.11",
    "@playwright/test": "1.58.2"
  },
  "build": {
    "appId": "com.starseek.fylune",
    "productName": "Fylune",
    "asar": true,
    "electronLanguages": [
      "ar",
      "de",
      "en",
      "es",
      "fr",
      "it",
      "ja",
      "ko",
      "zh_CN",
      "zh_TW"
    ],
    "afterPack": "scripts/release-after-pack.mjs",
    "electronUpdaterCompatibility": ">=2.16",
    "publish": [
      {
        "provider": "github",
        "owner": "georgezouq",
        "repo": "fylune",
        "releaseType": "release"
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdx",
          "json",
          "jsonl"
        ],
        "name": "Fylune Document",
        "description": "Markdown, MDX, JSON, and JSONL document",
        "role": "Editor"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/client/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*.map",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.d.mts",
      "!node_modules/**/*.d.cts",
      "!node_modules/**/{test,tests,__tests__}/**/*",
      "!node_modules/exceljs/dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "minimumSystemVersion": "14.0",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "icon": "build/icon.icns",
      "notarize": true,
      "extendInfo": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      },
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ]
    },
    "mas": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "minimumSystemVersion": "14.0",
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "icon": "build/icon.icns"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "dmg": {
      "title": "${productName} ${version}",
      "backgroundColor": "#f2f6f4",
      "iconSize": 112,
      "window": {
        "width": 620,
        "height": 420
      },
      "contents": [
        {
          "x": 170,
          "y": 210,
          "type": "file"
        },
        {
          "x": 450,
          "y": 210,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
